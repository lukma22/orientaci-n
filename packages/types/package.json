    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@quill/engine": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@quill/config": "*"
  }
}
